<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
	<fonts>
		<font name="labelFont" font-name="Helvetica Neue" size="13" bold="true" italic="false"/>
	</fonts>
	<colors>
		<color name="background" rgba="#1B1B1DFF"/>
		<color name="knobHandle" rgba="#F2F2F2FF"/>
		<color name="knobCorona" rgba="#57A6FFFF"/>
		<color name="knobShadow" rgba="#00000080"/>
		<color name="labelText" rgba="#C8C8CCFF"/>
	</colors>
	<template background-color="background" background-color-draw-style="filled" class="CViewContainer" mouse-enabled="true" name="view" opacity="1" origin="0, 0" size="200, 220" transparent="false" wants-focus="false">
		<view class="CKnob"
			control-tag="Amplitude"
			origin="55, 24"
			size="90, 90"
			min-value="0"
			max-value="1"
			default-value="0"
			angle-start="135"
			angle-range="270"
			corona-inset="3"
			corona-drawing="true"
			corona-outline="true"
			corona-color="knobCorona"
			handle-color="knobHandle"
			handle-shadow-color="knobShadow"
			handle-line-width="2"
			value-inset="0"
			zoom-factor="1.5"
			wheel-inc-value="0.01"
			mouse-enabled="true"
			opacity="1"
			transparent="false"
			wants-focus="true"
			tooltip="Amplitude"/>
		<view class="CTextLabel"
			origin="0, 128"
			size="200, 20"
			title="AMPLITUDE"
			font="labelFont"
			font-color="labelText"
			font-antialias="true"
			back-color="background"
			frame-color="background"
			text-alignment="center"
			transparent="true"
			mouse-enabled="false"
			opacity="1"
			wants-focus="false"/>
	</template>
	<control-tags>
		<control-tag name="Amplitude" tag="100"/>
	</control-tags>
</vstgui-ui-description>
